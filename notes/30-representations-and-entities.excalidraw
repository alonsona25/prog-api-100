      "link": null,
      "locked": false,
      "text": "Relational\nwrite ahead transaction\nlog",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t1upnLbAfVbd_TUoDMIe3",
      "originalText": "Relational\nwrite ahead transaction log",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TIj2JdcyLWk6mpiSLc_yT",
      "type": "text",
      "x": 560,
      "y": 1888,
      "width": 648.6873779296875,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 337061439,
      "version": 172,
      "versionNonce": 842481567,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791303448467,
      "link": null,
      "locked": false,
      "text": "tools that can \"scrape\" the transaction log\nand put that data in other databases, or publish them on an event stream (kafka)\n(debezium is really common for this)\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "tools that can \"scrape\" the transaction log\nand put that data in other databases, or publish them on an event stream (kafka)\n(debezium is really common for this)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

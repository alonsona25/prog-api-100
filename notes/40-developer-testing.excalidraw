      "isDeleted": false,
      "boundElements": null,
      "updated": 1791312120055,
      "link": null,
      "locked": false,
      "text": "You write enough tests\nthat you and your team\nare confident you've done your best\nto meet the requirements, and\na decision about a release can rely on\nthe set of passing tests you have.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You write enough tests\nthat you and your team\nare confident you've done your best\nto meet the requirements, and\na decision about a release can rely on\nthe set of passing tests you have.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RCXs7X_TpmaNyZzq_pLzM",
      "type": "text",
      "x": 593,
      "y": 149,
      "width": 345.69976806640625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 1945693753,
      "version": 119,
      "versionNonce": 1795134391,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791312045900,
      "link": null,
      "locked": false,
      "text": "\"White Box\" - transparent\n- breaks encapsulation\nknows how to the sausage is made.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"White Box\" - transparent\n- breaks encapsulation\nknows how to the sausage is made.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Hdht_GP5U2_Ap17dL38fw",
      "type": "text",
      "x": 938,
      "y": 513,
      "width": 412.479736328125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aQ",
      "roundness": null,
      "seed": 186957687,
      "version": 91,
      "versionNonce": 1570503449,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791312140523,
      "link": null,
      "locked": false,
      "text": "Almost 100% \"Black Box\"\n- knows nothing about the implementation.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Almost 100% \"Black Box\"\n- knows nothing about the implementation.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kW_lTZmMvrHdlAPO4psUJ",

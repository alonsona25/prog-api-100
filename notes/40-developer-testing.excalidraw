    {
      "id": "X0rfQq3VPPS2ISgqfc3VQ",
      "type": "text",
      "x": 467,
      "y": 746,
      "width": 366.9997253417969,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",

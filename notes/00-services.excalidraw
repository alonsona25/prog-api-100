      "index": "a1",
      "roundness": null,
      "seed": 773160251,
      "version": 111,
      "versionNonce": 1869686267,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791213159599,
      "link": null,
      "locked": false,
      "text": "\"Data should be encapsulated\" - \n\n\n\nMonorepo\n    - one code repository that all the developers work from.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Data should be encapsulated\" - \n\n\n\nMonorepo\n    - one code repository that all the developers work from.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

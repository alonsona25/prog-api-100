      "boundElements": null,
      "updated": 1791384087091,
      "link": null,
      "locked": false,
      "text": "Every fact (test) including each theory\ncreates a new instance of the test class.\nThis is GOOD for unit testing because unit tests\nare not supposed to share data. \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every fact (test) including each theory\ncreates a new instance of the test class.\nThis is GOOD for unit testing because unit tests\nare not supposed to share data. \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

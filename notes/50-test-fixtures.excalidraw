      "updated": 1791384204365,
      "link": null,
      "locked": false,
      "text": "Using a test fixture with IAsyncLifetime\n- make it so one test class can reuse the context\n  for every test/theory in that class.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Using a test fixture with IAsyncLifetime\n- make it so one test class can reuse the context\n  for every test/theory in that class.",
      "autoResize": true,
